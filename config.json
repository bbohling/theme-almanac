      "path": "archive",
      "baseName": "index",
      "isPlainText": true,
      "notAlternative": true
    },
    "PhotosHTML": {
      "mediaType": "text/html",
      "path": "photos",
      "baseName": "index",
      "isHTML": true,
      "notAlternative": true
    },
    "PhotosJSON": {
      "mediaType": "application/json",
      "path": "photos",
      "baseName": "index",
      "isPlainText": true,
      "notAlternative": true
    },
    "PodcastXML": {
      "mediaType": "application/rss+xml",
      "baseName": "podcast",
      "isPlainText": true,
